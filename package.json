{
  "name": "idu-cross-cli",
  "version": "2.1.0",
  "description": "Cross-CLI Agent Router & Quality Harness for Claude Code, OpenCode, Pi, Codex, Antigravity, Kimi, Qwen and Command Code",
  "private": true,
  "type": "module",
  "bin": {
    "idu-cross-cli": "dist/src/cli.js",
    "idu-pi-mcp": "dist/src/mcp-server.js",
    "idu-pi": "dist/src/cli.js"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node scripts/run-tests-isolated.mjs",
    "test:unisolated": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "test:guarded": "node scripts/run-tests-with-leak-guard.mjs",
    "test:protocol-drift": "node scripts/check-protocol-tool-drift.mjs",
    "test:repo-hygiene": "node scripts/check-repo-root-untracked.mjs",
    "verify": "corepack pnpm test && corepack pnpm run test:protocol-drift && corepack pnpm run test:repo-hygiene",
    "cli": "node dist/src/cli.js",
    "mcp": "node dist/src/mcp-server.js",
    "start": "node dist/src/cli.js"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  }
}

    "cli": "node dist/src/cli.js",
    "mcp": "node dist/src/mcp-server.js",
    "start": "node dist/src/cli.js"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  }
}

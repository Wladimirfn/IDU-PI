{
  "name": "idu-cross-cli",
  "version": "2.1.0",
  "description": "Cross-CLI Agent Router & Quality Harness for Claude Code, OpenCode, Pi, Codex and Antigravity",
  "private": true,
  "type": "module",
  "bin": {
    "idu-cross-cli": "dist/src/cli.js",
    "idu-pi-mcp": "dist/src/mcp-server.js",
    "idu-pi": "dist/src/cli.js"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
